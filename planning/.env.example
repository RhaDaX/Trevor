TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=change-me-with-node-ace-generate-key
APP_URL=http://localhost:3333
NODE_ENV=development
SESSION_DRIVER=cookie

# Fuseau de l'utilisateur pour la saisie naturelle, les rappels et le récap
APP_TIMEZONE=Europe/Paris

# Base MariaDB de l'outil
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=planning
DB_PASSWORD=planning
DB_DATABASE=planning

# Redis (file de jobs BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP (récap du matin)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=planning@example.com

# Boîte de capture IMAP (Infomaniak)
IMAP_HOST=mail.infomaniak.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Web Push (générer avec : node ace vapid:generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:planning@example.com

# CRM A — secret HMAC des webhooks + API de lecture du CRM
CRM_A_NAME=Entreprise A
CRM_A_WEBHOOK_SECRET=
CRM_A_API_URL=https://crm-a.example.com/api/planning
CRM_A_API_TOKEN=
CRM_A_URL_TEMPLATE=https://crm-a.example.com/clients/{id}

# CRM B
CRM_B_NAME=Entreprise B
CRM_B_WEBHOOK_SECRET=
CRM_B_API_URL=https://crm-b.example.com/api/planning
CRM_B_API_TOKEN=
CRM_B_URL_TEMPLATE=https://crm-b.example.com/clients/{id}
